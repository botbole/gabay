# Copy this file to .env and fill in your values

ENVIRONMENT=development
DEBUG=true

# Generate a unique value of at least 32 characters for deployed environments
JWT_SECRET=development-only-change-this-secret
JWT_ISSUER=gabay
JWT_AUDIENCE=gabay-web
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=strict

# LLM Provider: "openai" | "azure" | "ollama"
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_API_KEY=sk-...

# Optional: override base URL for Azure OpenAI or local Ollama
# LLM_BASE_URL=https://<your-resource>.openai.azure.com/

# CORS origins (comma-separated when set via env)
# CORS_ORIGINS=["http://localhost:3000"]
